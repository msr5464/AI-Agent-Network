# ─────────────────────────────────────────────────────────────────────────────
# config/.env.example — Shared configuration for all QA-Agent-Network agents
#
# Copy to config/.env and fill in your values. Never commit config/.env.
#
# Load order (shared/load_env.sh):
#   1. config/.env          ← shared base + agent defaults
#   2. agents/<agent>/.env  ← agent-specific overrides (wins over config/.env)
#
# Organized in 6 sections:
#   - common                vars used by 2+ agents or framework-wide
#   - test-authoring-agent  vars used only by test-authoring-agent
#   - test-healing-agent    vars used only by test-healing-agent
#   - test-triaging-agent   vars used only by test-triaging-agent
#   - test-adaptation-agent vars used only by test-adaptation-agent
#   - qa_agents_server      vars used by the AI-Test-Studio backend server
# ─────────────────────────────────────────────────────────────────────────────


# ═════════════════════════════════════════════════════════════════════════════
# common (used by 2+ agents or framework-wide)
# ═════════════════════════════════════════════════════════════════════════════

# Path to the claude CLI binary (default: claude, assumes it is on PATH)
CLAUDE_CLI_PATH=claude

# ── Workspace & Repo Configuration ───────────────────────────────────────────
# Parent directory containing the automation repo (must be OUTSIDE QA-Agent-Network)
WORKSPACE_DIR=

# Absolute path override to automation repo checkout (optional)
# FRAMEWORK_DIR=

# Name of the automation repo directory under WORKSPACE_DIR and on GitHub
GITHUB_REPO_AUTOMATION=Jarvis

# Default base branch for checkouts and PRs
GITHUB_DEFAULT_BRANCH=main

# Path to Markdown conventions file inside automation repo (optional)
# REPO_CONTEXT_FILE=CONVENTIONS.md

# Override test runner command ({class}, {class_simple}, {method})
# TEST_RUNNER_CMD=mvn test -pl Access -Dtest={class_simple}#{method} -Denvironment=staging

# ── GitHub ───────────────────────────────────────────────────────────────────
# GitHub personal access token with repo scope (required for PR creation)
GITHUB_TOKEN=

# GitHub org or username that owns the automation repo
GITHUB_ORG=

# Comma-separated list of GitHub reviewer handles (optional)
GITHUB_PR_REVIEWERS=

# ── Slack Notifications ──────────────────────────────────────────────────────
# Slack bot token for run summaries and failure alerts
SLACK_BOT_TOKEN=

# Slack channel for routine test run reports
SLACK_NOTIFY_CHANNEL=#qa-reports

# Slack channel for failure alerts and escalations
SLACK_ALERT_CHANNEL=#qa-critical

# ── Execution & Browser Controls ─────────────────────────────────────────────
# Push branch and create GitHub PR (false = local dry-run)
AUTO_PUSH=true

# Cache step outputs for fast local iteration (authoring & adaptation)
TESTING_MODE=false

# Run browsers headless (false = visible browser UI)
PLAYWRIGHT_HEADLESS=true

# Pinned version of @playwright/mcp package
PLAYWRIGHT_MCP_VERSION=0.0.79


# ═════════════════════════════════════════════════════════════════════════════
# test-authoring-agent
# ═════════════════════════════════════════════════════════════════════════════

# Claude model for authoring steps (parse, validate, generate, fix)
AUTHORING_MODEL=claude-opus-4-6

# Branch prefix for authoring PRs (<prefix>/<feature>-<timestamp>)
AUTHORING_BRANCH_PREFIX=authoring

# Maven -Denvironment value when verifying generated tests
AUTHORING_ENVIRONMENT=staging

# Maven -Dcountry value when verifying generated tests
AUTHORING_COUNTRY=SG

# Max retry cycles for failing generated tests (ceiling, not target)
AUTHORING_FIX_RETRY_COUNT=2

# Timeout (ms) per browser step during selector validation
AUTHORING_PLAYWRIGHT_TIMEOUT_MS=30000

# Path to Node.js executable
AUTHORING_NODE_PATH=node


# ═════════════════════════════════════════════════════════════════════════════
# test-healing-agent
# ═════════════════════════════════════════════════════════════════════════════

# Claude model for locator fixes
HEALING_MODEL=claude-opus-4-6

# Maximum distinct locator failure clusters to fix per session
HEALING_MAX_FIXES_PER_RUN=5

# Retry budget when locator fixes fail verification
HEALING_RETRY_COUNT=4

# Branch prefix for healing PRs (<prefix>/<build-tag>)
HEALING_BRANCH_PREFIX=healing

# ── Deterministic Locator Engine (01_locate.py) ──────────────────────────────
# Directory containing recorded element baseline fingerprints
# HEALING_BASELINE_DIR=${WORKSPACE_DIR}/${GITHUB_REPO_AUTOMATION}/src/main/resources/baselines

# Locate mode: 'shadow' (model decides) or 'enforce' (auto-apply verified fix)
HEALING_LOCATE_MODE=shadow

# Record element baseline fingerprints during green test runs
# HEALING_BASELINE_FINGERPRINTS=true

# Playwright storageState JSON for authenticated page locator verification
# HEALING_LOCATE_STORAGE_STATE=

# Custom locator scoring weights configuration file (optional)
# HEALING_LOCATE_CONFIG=config/locator.yaml


# ═════════════════════════════════════════════════════════════════════════════
# test-triaging-agent
# ═════════════════════════════════════════════════════════════════════════════

# ── Test Results Database ───────────────────────────────────────────────────
# Database host for test results
TRIAGING_DB_HOST=localhost

# Database port for test results
TRIAGING_DB_PORT=3306

# Database user for test results
TRIAGING_DB_USER=root

# Database password for test results
TRIAGING_DB_PASSWORD=

# Database name for test results
TRIAGING_DB_NAME=qa_results

# ── Classification & Review Models ──────────────────────────────────────────
# Claude model for failure root cause classification
TRIAGING_CLASSIFIER_MODEL=claude-opus-4-6

# Reasoning effort for classifier (low | medium | high)
TRIAGING_CLASSIFIER_EFFORT=medium

# Claude model for adversarial review of verdicts
TRIAGING_REVIEWER_MODEL=claude-sonnet-4-6

# Reasoning effort for reviewer (low | medium | high)
TRIAGING_REVIEWER_EFFORT=medium

# ── Triage Thresholds & Directories ─────────────────────────────────────────
# Lookback window in days when scanning for unanalyzed runs
TRIAGING_SCOUT_LOOKBACK_DAYS=7

# Maximum classify/review debate rounds before final verdict
TRIAGING_MAX_REVIEW_ROUNDS=2

# Number of recent runs to inspect for flaky test detection
TRIAGING_FLAKY_TESTS_LAST_RUNS=10

# Minimum failures in window to classify a test as flaky
TRIAGING_FLAKY_TESTS_MIN_FAILURES=5

# Directory containing input test reports
TRIAGING_INPUT_DIR=testdata

# Directory where generated triage reports are saved
TRIAGING_OUTPUT_DIR=reports

# Base URL for QA dashboard links in reports
TRIAGING_DASHBOARD_BASE_URL=https://qa.dashboard.example.com

# Base URL for Jira issue links in reports
TRIAGING_JIRA_BASE_URL=https://your-jira-instance.com

# Directory to queue actionable handoff files for healing agent (optional)
# TRIAGING_AUTOFIX_QUEUE_DIR=


# ═════════════════════════════════════════════════════════════════════════════
# test-adaptation-agent — update tests when the PRODUCT changes
# ═════════════════════════════════════════════════════════════════════════════

# Claude model for change note parsing and test adaptation
# ADAPTATION_MODEL=claude-opus-5

# Apply edits directly (true) vs propose diffs only (false)
# ADAPTATION_APPLY=false

# Scope of verification run (named_only | tiered | all)
# ADAPTATION_VERIFY_POLICY=named_only

# Wall-clock timeout (s) for browser exploration
# ADAPTATION_EXPLORE_TIMEOUT_S=1800

# Extra exploration attempts on recoverable browser failure
# ADAPTATION_EXPLORE_ATTEMPTS=1

# Retry budget when adapted tests fail verification
ADAPTATION_RETRY_COUNT=2

# Max test files touched per run before escalating
# ADAPTATION_MAX_FILES_PER_RUN=6

# Max total changed lines across all diffs
# ADAPTATION_MAX_TOTAL_DIFF_LINES=200

# Max tests in blast radius scope before escalating
# ADAPTATION_BLAST_MAX_TESTS=40

# Max dependency hops in blast radius graph traversal
# ADAPTATION_BLAST_MAX_HOPS=3

# Class reference count threshold to treat as shared hub
# ADAPTATION_HUB_THRESHOLD=8

# Explicit test files to force into blast radius (optional)
# ADAPTATION_BLAST_INCLUDE=

# Estimated run time (s) per test for blast planning
# ADAPTATION_SECONDS_PER_TEST=180

# Branch prefix for adaptation PRs (<prefix>/<module>-<timestamp>)
# ADAPTATION_BRANCH_PREFIX=adaptation

# Command to compile test suite before verification run
# ADAPTATION_TEST_COMPILE_CMD=mvn -q test-compile -DskipTests

# Timeout (s) per adapted test execution
# ADAPTATION_TEST_TIMEOUT_S=300

# Assert environment is disposable for destructive final steps
# ADAPTATION_SANDBOX=false

# Mandatory justification note when ADAPTATION_SANDBOX=true
# ADAPTATION_SANDBOX_NOTE=


# ═════════════════════════════════════════════════════════════════════════════
# qa_agents_server (HTTP server for the AI-Test-Studio admin UI)
# ═════════════════════════════════════════════════════════════════════════════

# Wall-clock budget (s) for an agent run before termination
QA_AGENT_RUN_TIMEOUT_SECONDS=7200

# Inactivity threshold (s) before a run is marked stale in UI
QA_AGENT_STALE_AFTER_SECONDS=900
