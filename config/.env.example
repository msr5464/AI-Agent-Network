###############################
# Database Configuration
###############################
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=qa_results

###############################
# Claude CLI (qa-auto-analyse + qa-auto-fix)
###############################
CLAUDE_CLI_PATH=claude
# Classification model — used in 03_classify.py
CLASSIFIER_MODEL=claude-opus-4-6
# Review model — used in 04_review.py (cheaper model is fine for review)
REVIEWER_MODEL=claude-sonnet-4-6
# Fix generation model — used in qa-auto-fix/01_fix.py (defaults to CLASSIFIER_MODEL if unset)
AUTOFIX_MODEL=claude-opus-4-6
# Max reviewer/classifier debate rounds (qa-auto-analyse)
MAX_REVIEW_ROUNDS=2

###############################
# qa-auto-analyse Behaviour
###############################
# Stop pipeline after this step: scout | collect | classify | review
STOP_AFTER=
# Lookback window for scout to find unanalyzed build tags
SCOUT_LOOKBACK_DAYS=7
# Direct mode: skip scout and analyze this build tag immediately
BUILD_TAG=

###############################
# qa-auto-fix Behaviour
###############################
# Set false to skip PR creation (dry-run mode)
AUTO_PUSH=true
# Max retry cycles if test verification fails
MAX_FIX_ATTEMPTS=2
# Path to qa-auto-fix queue directory (default: agents/qa-auto-fix/queue relative to repo root)
# Override if qa-auto-fix runs on a different machine or path
AUTOFIX_QUEUE_DIR=

###############################
# Report Paths
###############################
INPUT_DIR=testdata
OUTPUT_DIR=reports

###############################
# Dashboard URL
###############################
DASHBOARD_BASE_URL=https://qa.dashboard.example.com
JIRA_BASE_URL=https://your-jira-instance.com
###############################
# Flaky Tests Detection
###############################
FLAKY_TESTS_LAST_RUNS=10
FLAKY_TESTS_MIN_FAILURES=5

###############################
# Auto-Fix / GitHub Configuration
###############################
AUTO_FIX_ENABLED=false
AUTO_FIX_DRY_RUN=false
AUTO_FIX_MAX_FIXES_PER_RUN=3
GITHUB_TOKEN=
GITHUB_ORG=
GITHUB_REPO_AUTOMATION=                # Name of the automation repo dir under WORKSPACE_DIR
GITHUB_DEFAULT_BRANCH=main
# Branch prefix for autofix PRs. Branch name = <prefix>/<build-tag>
# e.g. chore/qa-autofix/prodsanity-all-tests-541
AUTOFIX_BRANCH_PREFIX=chore/qa-autofix
GITHUB_PR_REVIEWERS=

# Parent directory for the automation repo checkout. Must be OUTSIDE of QA-AI-Agent.
# If the repo is not already present, qa-auto-fix will clone it automatically using
# GITHUB_TOKEN + GITHUB_ORG + GITHUB_REPO_AUTOMATION.
# e.g. to place the automation repo at /home/runner/work/automation-repo, set:
#   WORKSPACE_DIR=/home/runner/work
#   GITHUB_REPO_AUTOMATION=automation-repo
WORKSPACE_DIR=

# Optional: path to a Markdown conventions file in the automation repo.
# Claude reads this before generating any fix, so it follows existing patterns
# (wrapper methods, @FindBy style, naming conventions, etc.)
# Can be absolute, or relative to the repo root (e.g. CONVENTIONS.md or docs/TESTING.md).
# If unset, auto-looks for CONVENTIONS.md / docs/TESTING.md / TESTING.md in repo root.
REPO_CONTEXT_FILE=CONVENTIONS.md       # Relative to GITHUB_REPO_AUTOMATION root

# Override the test runner command used to verify fixes after applying them.
# Use {class}, {class_simple}, {method}, {test_name} as placeholders.
# Required for frameworks that need extra flags.
# Example for a Gradle project:
#   TEST_RUNNER_CMD=./gradlew test --tests {class_simple}.{method} -PprojectName=Access -Penvironment=Staging -PbrowserName=Chrome
TEST_RUNNER_CMD=

###############################
# qa-auto-create Behaviour
###############################
# Claude model for code generation (default: claude-opus-4-6)
AUTOCREATE_MODEL=claude-opus-4-6
# Branch prefix for auto-create PRs. Branch = <prefix>/<feature>-<timestamp>
AUTOCREATE_BRANCH_PREFIX=feat/qa-autocreate
# Maven environment and country for test runs
AUTOCREATE_ENVIRONMENT=staging
AUTOCREATE_COUNTRY=SG
# Max retry cycles if generated test fails (default: 3)
# MAX_FIX_ATTEMPTS applies to qa-auto-create as well (shared env var)
# Playwright validation timeout in milliseconds (default: 30000)
PLAYWRIGHT_TIMEOUT_MS=30000
# Node.js binary path (default: node)
NODE_PATH=node

###############################
# Notifications
###############################
SLACK_BOT_TOKEN=
SLACK_NOTIFY_CHANNEL=#qa-reports
SLACK_ALERT_CHANNEL=#qa-critical

###############################
# Jira
###############################
JIRA_API_TOKEN=