# ─────────────────────────────────────────────────────────────────────────────
# config/.env.example — Shared configuration for all QA-Agent-Network agents
#
# Copy to config/.env and fill in your values. Never commit config/.env.
#
# Load order (shared/load_env.sh):
#   1. config/.env          ← this file (shared base + agent defaults)
#   2. agents/<agent>/.env  ← agent-specific overrides (win over this)
#
# Organized in 4 sections:
#   - common              vars used by 2+ agents
#   - test-authoring-agent
#   - test-healing-agent
#   - test-triaging-agent
# ─────────────────────────────────────────────────────────────────────────────


# ═════════════════════════════════════════════════════════════════════════════
# common (used by 2+ agents)
# ═════════════════════════════════════════════════════════════════════════════

# Path to the claude CLI binary (default: claude, assumes it is on PATH)
CLAUDE_CLI_PATH=claude

# ── GitHub (test-authoring-agent + test-healing-agent) ───────────────────────
# Personal access token with repo scope (required for PR creation)
GITHUB_TOKEN=
# GitHub org or username that owns the automation repo
GITHUB_ORG=
# Name of the automation repo directory under WORKSPACE_DIR
GITHUB_REPO_AUTOMATION=Jarvis
# Base branch for all PRs
GITHUB_DEFAULT_BRANCH=main
# Comma-separated list of GitHub reviewer handles (optional)
GITHUB_PR_REVIEWERS=

# Parent directory that contains the automation repo.
# Must be OUTSIDE of QA-Agent-Network.
WORKSPACE_DIR=

# ── Slack (all agents) ───────────────────────────────────────────────────────
SLACK_BOT_TOKEN=
SLACK_NOTIFY_CHANNEL=#qa-reports
SLACK_ALERT_CHANNEL=#qa-critical

# ── Fix/push behaviour (test-authoring-agent + test-healing-agent) ───────────
# Maximum fix-and-retry cycles before shipping with NEEDS-REVIEW verdict
MAX_FIX_ATTEMPTS=3
# Set to false to skip push and PR creation (dry-run)
AUTO_PUSH=true
# Set to true to cache step-01 (parse) and step-02 (validate web) outputs per
# feature so they are reused on re-runs — useful when iterating on code generation.
# Clear the cache: rm -rf agents/test-authoring-agent/cache/<feature>/
TESTING_MODE=false


# ═════════════════════════════════════════════════════════════════════════════
# test-authoring-agent
# ═════════════════════════════════════════════════════════════════════════════

# Claude model for all AI steps (parse, validate, generate, fix)
AUTOCREATE_MODEL=claude-opus-4-6
# Branch name prefix. Full branch: <prefix>/<feature>-<timestamp>
AUTOCREATE_BRANCH_PREFIX=feat/qa-autocreate
# Maven -Denvironment / -Dcountry values when verifying generated tests
AUTOCREATE_ENVIRONMENT=staging
AUTOCREATE_COUNTRY=SG
# Timeout (ms) for each Playwright step during selector validation
PLAYWRIGHT_TIMEOUT_MS=30000
# Set to false to run the browser in headed (visible) mode during [02/05] Validate Web
# Useful for debugging selector issues — set back to true for CI runs
PLAYWRIGHT_HEADLESS=true
# Version of @playwright/mcp to launch. Pinned rather than "latest" so npx does not
# re-resolve it against the npm registry on every browser step — a network hop on the
# startup path that has been seen to leave the MCP server unconnected when the model
# takes its first turn. Set to "latest" to restore floating behaviour.
PLAYWRIGHT_MCP_VERSION=0.0.79
# Path to Node.js binary
NODE_PATH=node


# ═════════════════════════════════════════════════════════════════════════════
# test-healing-agent
# ═════════════════════════════════════════════════════════════════════════════

# Claude model for locator fixes (01_fix.py)
AUTOFIX_MODEL=claude-opus-4-6
# Maximum number of tests to fix in a single session
AUTO_FIX_MAX_FIXES_PER_RUN=5
# Branch name prefix. Full branch: <prefix>/<build-tag>
AUTOFIX_BRANCH_PREFIX=chore/qa-autofix
# Path to a Markdown conventions file inside the automation repo (optional)
# REPO_CONTEXT_FILE=CONVENTIONS.md
# Override the test-runner command (optional). Placeholders: {class}, {class_simple}, {method}
# TEST_RUNNER_CMD=mvn test -pl Access -Dtest={class_simple}#{method} -Denvironment=staging


# ═════════════════════════════════════════════════════════════════════════════
# test-triaging-agent
# ═════════════════════════════════════════════════════════════════════════════

# ── Database ─────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=qa_results

# ── Classifier / Reviewer ────────────────────────────────────────────────────
CLASSIFIER_MODEL=claude-opus-4-6
CLASSIFIER_EFFORT=medium
REVIEWER_MODEL=claude-sonnet-4-6
REVIEWER_EFFORT=medium

# ── Scout / Review / Flaky thresholds ────────────────────────────────────────
SCOUT_LOOKBACK_DAYS=7
MAX_REVIEW_ROUNDS=2
FLAKY_TESTS_LAST_RUNS=10
FLAKY_TESTS_MIN_FAILURES=5

# ── Report paths ─────────────────────────────────────────────────────────────
# Directory containing test report HTML (relative to repo root or absolute)
INPUT_DIR=testdata
# Directory where generated HTML reports are saved
OUTPUT_DIR=reports

# ── External links ───────────────────────────────────────────────────────────
DASHBOARD_BASE_URL=https://qa.dashboard.example.com
JIRA_BASE_URL=https://your-jira-instance.com

# ── Handoff queue dir override (defaults to agents/test-healing-agent/queue) ─
# AUTOFIX_QUEUE_DIR=


# ═════════════════════════════════════════════════════════════════════════════
# qa_agents_server (HTTP server for the AI-Test-Studio admin UI)
# ═════════════════════════════════════════════════════════════════════════════

# Wall-clock budget for one agent run before it is killed
QA_AGENT_RUN_TIMEOUT_SECONDS=7200
# A session untouched for this long is treated as abandoned rather than running
QA_AGENT_STALE_AFTER_SECONDS=900

# ─────────────────────────────────────────────────────────────────────────────
# test-adaptation-agent — update tests when the PRODUCT changes
# ─────────────────────────────────────────────────────────────────────────────
# ADAPT_MODEL=claude-opus-5
# ADAPT_APPLY=false                 # false = propose only (diffs + guards, no writes)
# ADAPT_VERIFY_POLICY=named_only    # named_only | tiered | all
# ADAPT_EXPLORE_TIMEOUT_S=1800
# ADAPT_EXPLORE_ATTEMPTS=1
# ADAPT_MAX_FILES_PER_RUN=6
# ADAPT_MAX_TOTAL_DIFF_LINES=200
# ADAPT_BLAST_MAX_TESTS=40
# ADAPT_BLAST_MAX_HOPS=3
# ADAPT_HUB_THRESHOLD=8
# ADAPT_BLAST_INCLUDE=
# ADAPT_SECONDS_PER_TEST=180
# ADAPT_BRANCH_PREFIX=chore/qa-adapt
# TEST_COMPILE_CMD=mvn -q test-compile -DskipTests
# ADAPT_TEST_TIMEOUT_S=300
# MAX_ADAPT_ATTEMPTS=2
# ADAPT_SANDBOX=false               # requires ADAPT_SANDBOX_NOTE; quoted in the PR
# ADAPT_SANDBOX_NOTE=
