# ─────────────────────────────────────────────────────────────────────────────
# config/.env.example — Shared configuration for all QA-Agent-Network agents
#
# Copy to config/.env and fill in your values. Never commit config/.env.
#
# Load order (shared/load_env.sh):
#   1. config/.env          ← this file (shared base + agent defaults)
#   2. agents/<agent>/.env  ← agent-specific overrides (win over this)
#
# Organized in 4 sections:
#   - common              vars used by 2+ agents
#   - test-authoring-agent
#   - test-healing-agent
#   - test-triaging-agent
# ─────────────────────────────────────────────────────────────────────────────


# ═════════════════════════════════════════════════════════════════════════════
# common (used by 2+ agents)
# ═════════════════════════════════════════════════════════════════════════════

# Path to the claude CLI binary (default: claude, assumes it is on PATH)
CLAUDE_CLI_PATH=claude

# ── GitHub (test-authoring-agent + test-healing-agent) ───────────────────────
# Personal access token with repo scope (required for PR creation)
GITHUB_TOKEN=
# GitHub org or username that owns the automation repo
GITHUB_ORG=
# Name of the automation repo — both the directory under WORKSPACE_DIR and the
# repo name on GitHub, so it is required even when FRAMEWORK_DIR is set.
GITHUB_REPO_AUTOMATION=Jarvis
# Base branch for all PRs
GITHUB_DEFAULT_BRANCH=main
# Comma-separated list of GitHub reviewer handles (optional)
GITHUB_PR_REVIEWERS=

# Parent directory that contains the automation repo.
# Must be OUTSIDE of QA-Agent-Network.
WORKSPACE_DIR=

# Absolute path to the automation repo checkout itself. Optional: leave it unset
# and the path is WORKSPACE_DIR/GITHUB_REPO_AUTOMATION. Set it when the checkout
# is not named after the repo, or does not sit under WORKSPACE_DIR at all.
# Every agent, and locator_heal's Java/Python parity test, reads this one
# setting — nothing hardcodes a path.
# FRAMEWORK_DIR=

# ── Slack (all agents) ───────────────────────────────────────────────────────
SLACK_BOT_TOKEN=
SLACK_NOTIFY_CHANNEL=#qa-reports
SLACK_ALERT_CHANNEL=#qa-critical

# ── Retry budgets (one per agent, deliberately) ──────────────────────────────
# These were a single MAX_FIX_ATTEMPTS shared by authoring and healing, so setting
# a budget for one silently set it for the other. Healing earns the bigger number:
# each of its attempts fixes one locator and uncovers the next, so the loop walks a
# chain. The other two re-attack the same failure.
AUTHORING_FIX_RETRY_COUNT=2
HEALING_RETRY_COUNT=4
ADAPTATION_RETRY_COUNT=2

# ── Push behaviour ───────────────────────────────────────────────────────────
# Set to false to skip push and PR creation (dry-run)
AUTO_PUSH=true
# Set to true to cache step-01 (parse) and step-02 (validate web) outputs per
# feature so they are reused on re-runs — useful when iterating on code generation.
# Clear the cache: rm -rf agents/test-authoring-agent/cache/<feature>/
TESTING_MODE=false

# ── Browser (all agents) ─────────────────────────────────────────────────────
# THE browser switch, for the whole network — shared/browser_mode.py is the only
# thing that reads it, and every browser resolves its mode there. Set false and
# they are all visible: selector validation, live DOM inspection, exploration,
# session minting, the locate step's replay, and the Maven test runs themselves
# (passed through as -Dheadless, which the framework reads ahead of its own
# parameters/config.properties). Set back to true for CI runs.
# Commented out entirely, each browser keeps its own default — and a Maven run
# then follows the framework's parameters/config.properties instead.
PLAYWRIGHT_HEADLESS=true
# Version of @playwright/mcp the browser steps launch. Pinned rather than
# "latest" so npx does not re-resolve it against the npm registry on every
# browser step — a network hop on the startup path that has been seen to leave
# the MCP server unconnected when the model takes its first turn. Set to
# "latest" to restore floating behaviour.
PLAYWRIGHT_MCP_VERSION=0.0.79


# ═════════════════════════════════════════════════════════════════════════════
# test-authoring-agent
# ═════════════════════════════════════════════════════════════════════════════

# Claude model for all AI steps (parse, validate, generate, fix)
AUTOCREATE_MODEL=claude-opus-4-6
# Branch name prefix. Full branch: <prefix>/<feature>-<timestamp>
AUTOCREATE_BRANCH_PREFIX=feat/qa-autocreate
# Maven -Denvironment / -Dcountry values when verifying generated tests
AUTOCREATE_ENVIRONMENT=staging
AUTOCREATE_COUNTRY=SG
# Timeout (ms) for each Playwright step during selector validation
PLAYWRIGHT_TIMEOUT_MS=30000
# Path to Node.js binary
NODE_PATH=node


# ═════════════════════════════════════════════════════════════════════════════
# test-healing-agent
# ═════════════════════════════════════════════════════════════════════════════

# Claude model for locator fixes (01_fix.py)
AUTOFIX_MODEL=claude-opus-4-6
# Maximum number of tests to fix in a single session
AUTO_FIX_MAX_FIXES_PER_RUN=5
# Branch name prefix. Full branch: <prefix>/<build-tag>
AUTOFIX_BRANCH_PREFIX=chore/qa-autofix
# Path to a Markdown conventions file inside the automation repo (optional)
# REPO_CONTEXT_FILE=CONVENTIONS.md
# Override the test-runner command (optional). Placeholders: {class}, {class_simple}, {method}
# TEST_RUNNER_CMD=mvn test -pl Access -Dtest={class_simple}#{method} -Denvironment=staging

# ── Locate step: deterministic locator healing (01_locate.py) ────────────────
# The Locate step compares a failing page against an element fingerprint recorded
# while the locator still worked. Those fingerprints are written by the Java
# framework on GREEN runs only (Baseline.java), so the step reports
# "no baseline" for every locator until a passing suite has run at least once.
#
# NOT normally needed: the agent reads `baselineDir` from the framework's own
# parameters/config.properties, so both halves agree by default. Set this only to
# point somewhere else — e.g. a directory preserved by CI between builds.
# NOTE: expands WORKSPACE_DIR and GITHUB_REPO_AUTOMATION, so keep it below them.
# BASELINE_DIR=${WORKSPACE_DIR}/${GITHUB_REPO_AUTOMATION}/src/main/resources/baselines

# shadow  = Locate reports what it WOULD have done; the model still decides.
# enforce = a verified locator is applied and the model call is skipped.
# Start in shadow. This step can refuse work the agent used to attempt, and the
# thing to watch is disagreements — where Locate refused and the model "fixed"
# it anyway — before letting it decide. Same reasoning as DIAGNOSIS_MODE.
LOCATE_MODE=shadow

# Set to false to stop the Java framework fingerprinting at all. Costs one DOM
# walk per page object per test; the coverage counts are recorded either way.
# BASELINE_FINGERPRINTS=true

# Playwright storageState JSON for pages behind a login, so Locate can prove a
# candidate by performing the step rather than only scoring it. Without it, a
# locator on an authenticated page is ranked but never verified.
# Mint one with: python3 scripts/mint_session.py --module <module> --headed
# LOCATE_STORAGE_STATE=${WORKSPACE_DIR}/${GITHUB_REPO_AUTOMATION}/src/test/resources/naukari/loginStorage/NaukariLoginStorage.json

# Weights, thresholds and budgets for the locator engine.
# LOCATE_CONFIG=config/locator.yaml


# ═════════════════════════════════════════════════════════════════════════════
# test-triaging-agent
# ═════════════════════════════════════════════════════════════════════════════

# ── Database ─────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=qa_results

# ── Classifier / Reviewer ────────────────────────────────────────────────────
CLASSIFIER_MODEL=claude-opus-4-6
CLASSIFIER_EFFORT=medium
REVIEWER_MODEL=claude-sonnet-4-6
REVIEWER_EFFORT=medium

# ── Scout / Review / Flaky thresholds ────────────────────────────────────────
SCOUT_LOOKBACK_DAYS=7
MAX_REVIEW_ROUNDS=2
FLAKY_TESTS_LAST_RUNS=10
FLAKY_TESTS_MIN_FAILURES=5

# ── Report paths ─────────────────────────────────────────────────────────────
# Directory containing test report HTML (relative to repo root or absolute)
INPUT_DIR=testdata
# Directory where generated HTML reports are saved
OUTPUT_DIR=reports

# ── External links ───────────────────────────────────────────────────────────
DASHBOARD_BASE_URL=https://qa.dashboard.example.com
JIRA_BASE_URL=https://your-jira-instance.com

# ── Handoff queue dir override (defaults to agents/test-healing-agent/queue) ─
# AUTOFIX_QUEUE_DIR=


# ═════════════════════════════════════════════════════════════════════════════
# qa_agents_server (HTTP server for the AI-Test-Studio admin UI)
# ═════════════════════════════════════════════════════════════════════════════

# Wall-clock budget for one agent run before it is killed
QA_AGENT_RUN_TIMEOUT_SECONDS=7200
# A session untouched for this long is treated as abandoned rather than running
QA_AGENT_STALE_AFTER_SECONDS=900

# ─────────────────────────────────────────────────────────────────────────────
# test-adaptation-agent — update tests when the PRODUCT changes
# ─────────────────────────────────────────────────────────────────────────────
# ADAPT_MODEL=claude-opus-5
# ADAPT_APPLY=false                 # false = propose only (diffs + guards, no writes)
# ADAPT_VERIFY_POLICY=named_only    # named_only | tiered | all
# ADAPT_EXPLORE_TIMEOUT_S=1800
# ADAPT_EXPLORE_ATTEMPTS=1
# ADAPT_MAX_FILES_PER_RUN=6
# ADAPT_MAX_TOTAL_DIFF_LINES=200
# ADAPT_BLAST_MAX_TESTS=40
# ADAPT_BLAST_MAX_HOPS=3
# ADAPT_HUB_THRESHOLD=8
# ADAPT_BLAST_INCLUDE=
# ADAPT_SECONDS_PER_TEST=180
# ADAPT_BRANCH_PREFIX=chore/qa-adapt
# TEST_COMPILE_CMD=mvn -q test-compile -DskipTests
# ADAPT_TEST_TIMEOUT_S=300
# ADAPTATION_RETRY_COUNT=2
# ADAPT_SANDBOX=false               # requires ADAPT_SANDBOX_NOTE; quoted in the PR
# ADAPT_SANDBOX_NOTE=
