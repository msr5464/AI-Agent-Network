# ─────────────────────────────────────────────────────────────────────────────
# config/.env.example — Shared configuration for all QA-Agent-Nexus agents
#
# Copy to config/.env and fill in your values.
# Never commit config/.env — it contains secrets.
#
# Load order (shared/load_env.sh):
#   1. config/.env          ← this file (shared base)
#   2. agents/<agent>/.env  ← agent-specific overrides (wins over this)
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (test-triaging-agent) ────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=qa_results

# ── Claude CLI (all agents) ───────────────────────────────────────────────────
# Path to the claude CLI binary (default: claude, assumes it is on PATH)
CLAUDE_CLI_PATH=claude

# ── GitHub (test-healing-agent + test-authoring-agent) ────────────────────────────────────
# Personal access token with repo scope (required for PR creation)
GITHUB_TOKEN=

# GitHub org or username that owns the automation repo
GITHUB_ORG=

# Name of the automation repo directory under WORKSPACE_DIR
GITHUB_REPO_AUTOMATION=Jarvis

# Base branch for all PRs
GITHUB_DEFAULT_BRANCH=main

# Comma-separated list of GitHub reviewer handles (optional)
GITHUB_PR_REVIEWERS=

# Parent directory that contains the automation repo.
# Must be OUTSIDE of QA-Agent-Nexus.
# e.g. if automation repo is at /home/runner/work/Jarvis, set:
#   WORKSPACE_DIR=/home/runner/work
WORKSPACE_DIR=

# ── Notifications (all agents) ───────────────────────────────────────────────
SLACK_BOT_TOKEN=
SLACK_NOTIFY_CHANNEL=#qa-reports
SLACK_ALERT_CHANNEL=#qa-critical

# ── Dashboard / Jira links (test-triaging-agent) ─────────────────────────────────
DASHBOARD_BASE_URL=https://qa.dashboard.example.com
JIRA_BASE_URL=https://your-jira-instance.com

# ── Report paths (test-triaging-agent) ───────────────────────────────────────────
# Directory containing test report HTML (relative to repo root or absolute)
INPUT_DIR=testdata
# Directory where generated HTML reports are saved
OUTPUT_DIR=reports
