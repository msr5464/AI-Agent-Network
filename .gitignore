# ── Agent runtime state ───────────────────────────────────────────────────────
# Everything below is per-run transaction data, not source. Each agent's run.sh
# does `mkdir -p` on what it needs and the server recreates its own storage on
# boot, so a fresh clone works with none of it present.

# Per-session audit trails and LLM caches, for every agent.
agents/*/audit/
agents/*/cache/

# The live work inbox. The server writes into it (POST /agents/<agent>/queue)
# and run.sh moves each item into processed/ once it completes — so a tracked
# file here turns into a deletion the first time anyone runs the agent.
# Input format examples for each agent live in docs/examples/queue/.
agents/*/queue/

# Per-run bookkeeping the agents append to; `make clear-feedback` resets them.
# feedback/known-issues.json is deliberately NOT ignored: it holds hand-written
# triage rules that a fresh clone needs.
agents/*/feedback/skip-buildtags.json
agents/*/feedback/proposals.json

# Server run registry — rewritten on every run, reloaded or recreated on boot.
qa_agents_server/storage/agent_runs.json

# Append-only analytics store — runtime data, grows per run, never pruned.
qa_agents_server/storage/run_analytics.jsonl

# Personal, machine-specific Claude Code permissions.
.claude/settings.local.json

# Locator-heal test bench: recorded fingerprints, not the framework's baselines
# (those live in the Playwright repo under src/main/resources/baselines).
# Rewritten by eval.py / live_check.py on every run and stamped with absolute
# fixture paths, a capture timestamp and the current app commit.
locator_heal/baselines/
