# ─────────────────────────────────────────────────────────────────────────────
# qa-auto-create agent — environment configuration
# Copy this file to .env and fill in the values before running.
# Never commit .env — it contains secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ──────────────────────────────────────────────────────────────────

# Absolute path to the directory that CONTAINS the Jarvis repo folder.
# e.g. if Jarvis is at /Users/mukesh/msr5464/QA-AI-Agent/Jarvis,
# then WORKSPACE_DIR=/Users/mukesh/msr5464/QA-AI-Agent
WORKSPACE_DIR=/Users/mukesh/msr5464/QA-AI-Agent

# Name of the Jarvis repo directory (default: Jarvis)
GITHUB_REPO_AUTOMATION=Jarvis

# GitHub personal access token for PR creation (needs repo scope)
GITHUB_TOKEN=ghp_...

# GitHub org or username that owns the Jarvis repo
GITHUB_ORG=msr5464

# ── Optional ──────────────────────────────────────────────────────────────────

# Claude model to use (default: claude-opus-4-6)
AUTOCREATE_MODEL=claude-opus-4-6

# Path to claude CLI binary if not on PATH
# CLAUDE_CLI_PATH=claude

# Base branch for PRs (default: main)
# GITHUB_DEFAULT_BRANCH=main

# Comma-separated list of GitHub reviewer handles
# GITHUB_PR_REVIEWERS=reviewer1,reviewer2

# Branch name prefix (default: feat/qa-autocreate)
# AUTOCREATE_BRANCH_PREFIX=feat/qa-autocreate

# Max fix-and-retry cycles before shipping with NEEDS-REVIEW (default: 3)
# MAX_FIX_ATTEMPTS=3

# Set to false to generate and test but skip push/PR (dry-run)
# AUTO_PUSH=true

# Maven environment and country for running tests
# AUTOCREATE_ENVIRONMENT=staging
# AUTOCREATE_COUNTRY=SG

# Playwright validation timeout in milliseconds (default: 30000)
# PLAYWRIGHT_TIMEOUT_MS=30000

# ── Slack (optional) ──────────────────────────────────────────────────────────
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_NOTIFY_CHANNEL=#qa-automation
# SLACK_ALERT_CHANNEL=#qa-alerts
