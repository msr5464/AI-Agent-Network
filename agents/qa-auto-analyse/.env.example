# QA Agent — Environment Variables
# Copy to .env and fill in your values.
# Agent .env overrides root config/.env.

# ── Scout ─────────────────────────────────────────────────────────────────────
SCOUT_LOOKBACK_DAYS=7       # Days to look back for unanalyzed build tags
# BUILD_TAG=               # Direct mode: skip scout, analyze this build tag

# ── Agent Behaviour ───────────────────────────────────────────────────────────
MAX_REVIEW_ROUNDS=2          # Max reviewer/classifier debate rounds
# STOP_AFTER=               # scout | collect | classify | review

# ── Claude CLI ────────────────────────────────────────────────────────────────
CLAUDE_CLI_PATH=claude
CLASSIFIER_MODEL=claude-opus-4-6
CLASSIFIER_EFFORT=medium
REVIEWER_MODEL=claude-sonnet-4-6
REVIEWER_EFFORT=medium

# ── Notifications ─────────────────────────────────────────────────────────────
SLACK_NOTIFY_CHANNEL=#qa-reports
SLACK_ALERT_CHANNEL=#qa-critical
# SLACK_BOT_TOKEN=          # Already set in root config/.env

# ── Inherited from root config/.env (no need to repeat unless overriding) ─────
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=qa_results
# INPUT_DIR=testdata
# OUTPUT_DIR=reports
# GITHUB_TOKEN=
# GITHUB_ORG=
# GITHUB_REPO_AUTOMATION=
# GITHUB_DEFAULT_BRANCH=main
# GITHUB_PR_REVIEWERS=
