# ─────────────────────────────────────────────────────────────────────────────
# agents/test-healing-agent/.env.example — Agent-specific overrides
#
# Copy to agents/test-healing-agent/.env and uncomment what you want to change.
# Values here override config/.env for this agent only.
# Shared settings (DB, GitHub, Slack, WORKSPACE_DIR) stay in config/.env.
# ─────────────────────────────────────────────────────────────────────────────

# ── Claude model ──────────────────────────────────────────────────────────────
# Model used to generate locator fixes (01_fix.py)
AUTOFIX_MODEL=claude-opus-4-6

# ── Fix behaviour ─────────────────────────────────────────────────────────────
# Maximum number of tests to fix in a single session
AUTO_FIX_MAX_FIXES_PER_RUN=5

# Maximum retry cycles if test verification fails before shipping
MAX_FIX_ATTEMPTS=2

# Set to false to apply and test fixes locally but skip push and PR creation
AUTO_PUSH=true

# Branch name prefix for fix PRs. Full branch: <prefix>/<build-tag>
AUTOFIX_BRANCH_PREFIX=chore/qa-autofix

# ── Conventions file ──────────────────────────────────────────────────────────
# Path to a Markdown conventions file inside the automation repo.
# Claude reads this before generating any fix to follow existing patterns.
# Can be relative to the automation repo root, or an absolute path.
# If unset, auto-looks for: CONVENTIONS.md, docs/TESTING.md, TESTING.md
# REPO_CONTEXT_FILE=CONVENTIONS.md

# ── Test runner override ──────────────────────────────────────────────────────
# Override the command used to verify fixes. Placeholders:
#   {class}        fully-qualified class name
#   {class_simple} simple class name
#   {method}       test method name
# Example (Maven):
#   TEST_RUNNER_CMD=mvn test -pl Access -Dtest={class_simple}#{method} -Denvironment=staging
# Example (Gradle):
#   TEST_RUNNER_CMD=./gradlew test --tests {class_simple}.{method}
# TEST_RUNNER_CMD=
