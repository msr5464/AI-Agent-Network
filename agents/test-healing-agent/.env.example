# ─────────────────────────────────────────────────────────────────────────────
# agents/test-healing-agent/.env.example — Agent-specific overrides
#
# Copy to agents/test-healing-agent/.env and uncomment what you want to change.
# Values here override config/.env for this agent only.
# Shared settings (DB, GitHub, Slack, WORKSPACE_DIR) stay in config/.env.
# ─────────────────────────────────────────────────────────────────────────────

# ── Claude model ──────────────────────────────────────────────────────────────
# Model used to generate locator fixes (01_fix.py)
AUTOFIX_MODEL=claude-opus-5

# ── Fix behaviour ─────────────────────────────────────────────────────────────
# Maximum number of DISTINCT LOCATOR FIXES per session — not tests. One fix can
# green several tests, so 30 failures caused by 6 broken locators fit comfortably
# in a budget of 6. Clusters are attempted largest-first; any left over are
# reported as deferred rather than dropped.
AUTO_FIX_MAX_FIXES_PER_RUN=5

# Maximum retry cycles if test verification fails before shipping.
# Retries only re-attempt the tests that actually failed.
# An attempt that repairs one locator and uncovers the next keeps its edit,
# so the loop walks a chain of broken locators rather than re-guessing at one.
HEALING_RETRY_COUNT=4

# Set to false to apply and test fixes locally but skip push and PR creation
AUTO_PUSH=true

# Branch name prefix for fix PRs. Full branch: <prefix>/<build-tag>
AUTOFIX_BRANCH_PREFIX=chore/qa-autofix

# Reject any single fix whose diff exceeds this many changed lines. A locator
# change is a line or two; anything larger is the model rewriting a file it only
# saw an excerpt of.
# AUTOFIX_MAX_DIFF_LINES=40

# Character budget for each page object shown to Claude. Field, annotation and
# constructor declarations are ALWAYS kept in full regardless of this value —
# only method bodies are dropped to fit.
# AUTOFIX_PAGE_OBJECT_CHARS=8000

# ── Standalone mode ───────────────────────────────────────────────────────────
# Run and fix one named test without waiting for a triaging handoff:
#   make run AGENT=test-healing-agent TEST=LoginTest#testLogin
#   ./scripts/run-fix-test.sh LoginTest#testLogin
# Set per-invocation rather than here.
#   TEST_NAME  Class#method | Class.method | pkg.Class.method | Class
#   FORCE      true -> fix even when the failure is not locator-shaped
#   REPAIR     true -> park the browser on the failing page (see below)
# Budget for the reproduce run:
# AUTOFIX_REPRODUCE_TIMEOUT_S=900

# ── Repair mode ───────────────────────────────────────────────────────────────
# Automatic, and only on RETRY: the first attempt uses the failure-time DOM
# snapshot (fast, headless). If that produces no working fix, the agent re-runs
# the test with the browser parked and attaches over CDP — the only tier that can
# count how many elements a candidate selector matches and try the fix live.
# The browser is launched detached so it outlives the test JVM, and the agent
# terminates it when finished.
#
# Skipped automatically for pipeline runs, under CI, with no display, or when the
# port is busy. Override:
#   REPAIR=true    park from the first attempt
#   REPAIR=false   never park
# AUTOFIX_REPAIR_PORT=9222
# AUTOFIX_REPAIR_SESSION=/path/to/test-output/.repair-session.json

# ── Live DOM inspection ───────────────────────────────────────────────────────
# Before asking for a fix, open the failing page in a real browser (Playwright
# MCP) and read the element's ACTUAL selector, verified unique. Without this the
# agent can only infer the new selector from source that predates the failure.
# Requires a page URL: taken from AUTOFIX_BASE_URL, or recovered from a `url=`
# marker / any http(s) URL in the failure's execution log.
# Only used when the handoff carries no failure-time DOM snapshot; a snapshot
# always wins, since a live browser cannot reproduce mid-flow state.
AUTOFIX_INSPECT_DOM=true

# Explicit page URL, overriding whatever is recovered from the log.
# AUTOFIX_BASE_URL=https://app.staging.example.com

# Wall-clock budget (seconds) for one browser inspection run
# AUTOFIX_DOM_TIMEOUT_S=600

# Set false to watch every browser this agent starts: the DOM inspection, the
# locate step's replay, session minting, and the reproduce / verification /
# probe test runs (passed to maven as -Dheadless).
# PLAYWRIGHT_HEADLESS=true

# Which parameters/{environment}-{country}.properties file to read for the
# module's entry URL and login. This is the same file the tests themselves read
# via config.getRunTimeProperty(), so credentials do not need duplicating here.
# AUTOFIX_ENVIRONMENT=staging
# AUTOFIX_COUNTRY=SG

# Last-resort credential override. Normally unnecessary: a session the framework
# already saved (src/test/resources/{module}/loginStorage/*.json) is reused first,
# which logs the browser in without any credential reaching the prompt.
# AUTOFIX_LOGIN_USERNAME=
# AUTOFIX_LOGIN_PASSWORD=

# ── Conventions file ──────────────────────────────────────────────────────────
# Path to a Markdown conventions file inside the automation repo.
# Claude reads this before generating any fix to follow existing patterns.
# Can be relative to the automation repo root, or an absolute path.
# If unset, auto-looks for: CONVENTIONS.md, CLAUDE.md, docs/TESTING.md, TESTING.md
# REPO_CONTEXT_FILE=CONVENTIONS.md

# ── Page object discovery ─────────────────────────────────────────────────────
# Comma-separated directories (relative to the automation repo root) to search
# for page objects. Leave unset to derive them from the repo layout
# (src/main/java, src/main/kotlin, src/test/java, ... then the repo root).
# PAGE_OBJECT_DIRS=src/main/java/Automation/Access,src/main/java/Automation/Spend

# ── Test runner override ──────────────────────────────────────────────────────
# Override the command used to verify fixes. Placeholders:
#   {class}        fully-qualified class name
#   {class_simple} simple class name
#   {method}       test method name
# If no runner can be detected and this is unset, fixes are applied but reported
# as UNVERIFIED — never as passing.
# Example (Maven):
#   TEST_RUNNER_CMD=mvn test -pl Access -Dtest={class_simple}#{method} -Denvironment=staging
# Example (Gradle):
#   TEST_RUNNER_CMD=./gradlew test --tests {class_simple}.{method}
# TEST_RUNNER_CMD=

# Timeout (seconds) for a single verification test run
# AUTOFIX_TEST_TIMEOUT_S=300
