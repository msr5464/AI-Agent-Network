# ─────────────────────────────────────────────────────────────────────────────
# agents/test-healing-agent/.env.example — Agent-specific overrides
#
# Copy to agents/test-healing-agent/.env and uncomment what you want to change.
# Values here override config/.env for this agent only.
# ─────────────────────────────────────────────────────────────────────────────

# ── Healing Settings ─────────────────────────────────────────────────────────
# Claude model used for locator repairs (01_fix.py)
HEALING_MODEL=claude-opus-5

# Maximum number of distinct locator fixes per session
HEALING_MAX_FIXES_PER_RUN=5

# Retry budget when test verification fails
HEALING_RETRY_COUNT=4

# Branch prefix for healing PRs (<prefix>/<build-tag>)
HEALING_BRANCH_PREFIX=healing

# Max diff lines permitted for a single locator fix (optional)
# AUTOFIX_MAX_DIFF_LINES=40

# Character budget for each page object shown in prompt (optional)
# AUTOFIX_PAGE_OBJECT_CHARS=8000

# ── Deterministic Locate Step (01_locate.py) ─────────────────────────────────
# Directory containing recorded element baseline fingerprints (optional)
# HEALING_BASELINE_DIR=

# Locate mode: 'shadow' (model decides) or 'enforce' (auto-apply verified fix)
# HEALING_LOCATE_MODE=shadow

# Record element baseline fingerprints during green test runs (optional)
# HEALING_BASELINE_FINGERPRINTS=true

# Playwright storageState JSON for authenticated page locator verification (optional)
# HEALING_LOCATE_STORAGE_STATE=

# Custom locator scoring weights configuration file (optional)
# HEALING_LOCATE_CONFIG=config/locator.yaml

# ── Live DOM Inspection & Repair ─────────────────────────────────────────────
# Open failing page in live browser to extract actual element selector
HEALING_INSPECT_DOM=true

# Explicit page URL override for DOM inspection (optional)
# HEALING_BASE_URL=https://app.staging.example.com

# Wall-clock budget (s) for browser DOM inspection (optional)
# AUTOFIX_DOM_TIMEOUT_S=600

# Execution timeout (s) for test reproduction run (optional)
# AUTOFIX_REPRODUCE_TIMEOUT_S=900

# CDP port for live browser repair (optional)
# AUTOFIX_REPAIR_PORT=9222

# Path to persistent repair session JSON (optional)
# AUTOFIX_REPAIR_SESSION=

# ── Environment & Conventions ────────────────────────────────────────────────
# Path to conventions file inside automation repo (optional)
# REPO_CONTEXT_FILE=CONVENTIONS.md

# Comma-separated page object search directories (optional)
# PAGE_OBJECT_DIRS=src/main/java/Automation/Access,src/main/java/Automation/Spend

# Override test runner command ({class}, {class_simple}, {method}) (optional)
# TEST_RUNNER_CMD=mvn test -pl Access -Dtest={class_simple}#{method} -Denvironment=staging

# Timeout (s) for single verification test run (optional)
# HEALING_TEST_TIMEOUT_S=300

# ── Execution Controls ───────────────────────────────────────────────────────
# Push branch and create GitHub PR (false = local dry-run)
AUTO_PUSH=true

# Run browsers headless (false = visible browser UI)
PLAYWRIGHT_HEADLESS=true
