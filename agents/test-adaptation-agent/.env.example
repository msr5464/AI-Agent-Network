# Copy to agents/test-adaptation-agent/.env and uncomment what you want to change.
# Values here override config/.env for this agent only.

# ── Model ────────────────────────────────────────────────────────────────────
# ADAPT_MODEL=claude-opus-5

# ── Authority ────────────────────────────────────────────────────────────────
# Propose-only is the default while the guards earn trust: full diffs and guard
# results are recorded, nothing is written. Turn this on once you have seen the
# proposals being accepted verbatim.
# ADAPT_APPLY=false

# named_only | tiered | all. The verify set holds the server's single global run
# slot, so `all` can make the whole platform single-tasked for an hour.
# ADAPT_VERIFY_POLICY=named_only

# ── Exploration ──────────────────────────────────────────────────────────────
# ADAPT_EXPLORE_TIMEOUT_S=1800
# ADAPT_EXPLORE_ATTEMPTS=1
# Set false to watch every browser: exploration, session minting, and the
# verification test runs (passed to maven as -Dheadless).
# PLAYWRIGHT_HEADLESS=true

# ── Signing in ───────────────────────────────────────────────────────────────
# The session comes from the entry path the test under adaptation declares: the
# storage state it loads, or the login helper it calls, run through
# automation.core.SessionMinter. Set false to require a session that already
# exists rather than establishing one.
# ADAPT_MINT_SESSION=true
# How long that login gets. It compiles the automation repo first, so the first
# run in a fresh checkout is the slow one.
# ADAPT_MINT_TIMEOUT_S=420

# A flow whose outcome is itself destructive (placing an order, deleting a
# record) stops before the final action and escalates. Overriding that is an
# assertion that the environment is disposable, and the note is reproduced
# verbatim in the PR body.
# ADAPT_SANDBOX=false
# ADAPT_SANDBOX_NOTE=

# ── Budgets ──────────────────────────────────────────────────────────────────
# ADAPT_MAX_FILES_PER_RUN=6
# ADAPT_MAX_TOTAL_DIFF_LINES=200
# ADAPT_BLAST_MAX_TESTS=40
# ADAPT_BLAST_MAX_HOPS=3
# ADAPT_HUB_THRESHOLD=8
# ADAPT_BLAST_INCLUDE=            # force a class back in despite looking like a hub
# ADAPT_SECONDS_PER_TEST=180      # only used for the cost estimate

# ── Verification ─────────────────────────────────────────────────────────────
# TEST_COMPILE_CMD=mvn -q test-compile -DskipTests
# ADAPT_TEST_TIMEOUT_S=300
# MAX_ADAPT_ATTEMPTS=2

# ── Shipping ─────────────────────────────────────────────────────────────────
# ADAPT_BRANCH_PREFIX=chore/qa-adapt
# AUTO_PUSH=true

# ── Development ──────────────────────────────────────────────────────────────
# TESTING_MODE=true               # cache steps 01-03 under cache/<module>/
# EXPLORE_ONLY=true               # stop after the flow map, write no code
