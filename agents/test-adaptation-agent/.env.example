# ─────────────────────────────────────────────────────────────────────────────
# agents/test-adaptation-agent/.env.example — Agent-specific overrides
#
# Copy to agents/test-adaptation-agent/.env and uncomment what you want to change.
# Values here override config/.env for this agent only.
# ─────────────────────────────────────────────────────────────────────────────

# ── Adaptation Settings ──────────────────────────────────────────────────────
# Claude model for change note parsing and test adaptation (optional)
# ADAPTATION_MODEL=claude-opus-5

# Apply edits directly (true) vs propose diffs only (false) (optional)
# ADAPTATION_APPLY=false

# Scope of verification run (named_only | tiered | all) (optional)
# ADAPTATION_VERIFY_POLICY=named_only

# Wall-clock timeout (s) for browser exploration (optional)
# ADAPTATION_EXPLORE_TIMEOUT_S=1800

# Extra exploration attempts on recoverable browser failure (optional)
# ADAPTATION_EXPLORE_ATTEMPTS=1

# Retry budget when adapted tests fail verification (optional)
# ADAPTATION_RETRY_COUNT=2

# Max test files touched per run before escalating (optional)
# ADAPTATION_MAX_FILES_PER_RUN=6

# Max total changed lines across all diffs (optional)
# ADAPTATION_MAX_TOTAL_DIFF_LINES=200

# Max tests in blast radius scope before escalating (optional)
# ADAPTATION_BLAST_MAX_TESTS=40

# Max dependency hops in blast radius graph traversal (optional)
# ADAPTATION_BLAST_MAX_HOPS=3

# Class reference count threshold to treat as shared hub (optional)
# ADAPTATION_HUB_THRESHOLD=8

# Explicit test files to force into blast radius (optional)
# ADAPTATION_BLAST_INCLUDE=

# Estimated run time (s) per test for blast planning (optional)
# ADAPTATION_SECONDS_PER_TEST=180

# Branch prefix for adaptation PRs (<prefix>/<module>-<timestamp>) (optional)
# ADAPTATION_BRANCH_PREFIX=adaptation

# Command to compile test suite before verification run (optional)
# ADAPTATION_TEST_COMPILE_CMD=mvn -q test-compile -DskipTests

# Timeout (s) per adapted test execution (optional)
# ADAPTATION_TEST_TIMEOUT_S=300

# Assert environment is disposable for destructive final steps (optional)
# ADAPTATION_SANDBOX=false

# Mandatory justification note when ADAPTATION_SANDBOX=true (optional)
# ADAPTATION_SANDBOX_NOTE=

# ── Session & Minting ────────────────────────────────────────────────────────
# Mint session cookies before exploring authenticated pages (optional)
# ADAPT_MINT_SESSION=true

# Wall-clock timeout (s) for session minting (optional)
# ADAPT_MINT_TIMEOUT_S=420

# ── Execution Controls ───────────────────────────────────────────────────────
# Push branch and create GitHub PR (false = local dry-run) (optional)
# AUTO_PUSH=true

# Run browsers headless (false = visible browser UI) (optional)
# PLAYWRIGHT_HEADLESS=true

# Cache steps 01-03 outputs for fast iteration (optional)
# TESTING_MODE=true

# Stop after flow mapping without writing code (optional)
# EXPLORE_ONLY=true
