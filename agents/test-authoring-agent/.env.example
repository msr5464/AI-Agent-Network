# ─────────────────────────────────────────────────────────────────────────────
# agents/test-authoring-agent/.env.example — Agent-specific overrides
#
# Copy to agents/test-authoring-agent/.env and fill in the required values.
# Values here override config/.env for this agent only.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required overrides ────────────────────────────────────────────────────────
# Absolute path to the directory that CONTAINS the automation repo folder.
# e.g. if Jarvis is at /Users/mukesh/work/Jarvis, set:
#   WORKSPACE_DIR=/Users/mukesh/work
WORKSPACE_DIR=

# Name of the automation repo directory under WORKSPACE_DIR (default: Jarvis)
GITHUB_REPO_AUTOMATION=Jarvis

# GitHub personal access token for PR creation (needs repo scope)
GITHUB_TOKEN=

# GitHub org or username that owns the automation repo
GITHUB_ORG=

# ── Claude model ──────────────────────────────────────────────────────────────
# Model used for all AI steps: parse, validate, generate, fix (01–04)
AUTOCREATE_MODEL=claude-opus-4-6

# ── Create behaviour ──────────────────────────────────────────────────────────
# Branch name prefix for auto-create PRs. Full branch: <prefix>/<feature>-<timestamp>
AUTOCREATE_BRANCH_PREFIX=feat/qa-autocreate

# Maximum fix-and-retry cycles before shipping with NEEDS-REVIEW verdict
MAX_FIX_ATTEMPTS=3

# Set to false to generate and test locally but skip push and PR creation (dry-run)
AUTO_PUSH=true

# ── Maven test runner ─────────────────────────────────────────────────────────
# Environment passed as -Denvironment to Maven when verifying generated tests
AUTOCREATE_ENVIRONMENT=staging

# Country passed as -Dcountry to Maven
AUTOCREATE_COUNTRY=SG

# Wall-clock timeout in SECONDS for a single `mvn test` invocation in step [04/05]
MAVEN_TEST_TIMEOUT_S=300

# Directory name (under the Maven project root) the Java framework writes its
# JSON test report and screenshots to — must match Config.resultsDirectory in
# the framework. Only change this if the framework's default was overridden.
# TEST_RESULTS_DIR_NAME=test-output

# ── Playwright web validation ──────────────────────────────────────────────────
# Timeout in milliseconds for each individual browser action during validation
PLAYWRIGHT_TIMEOUT_MS=30000

# Wall-clock budget in SECONDS for the whole step [02/05] Validate Web run.
# A login-gated flow of 10+ steps on a heavy site routinely needs 15-25 minutes.
# On timeout the run is killed but partial selectors are still recovered and used.
VALIDATE_WEB_TIMEOUT_S=1800

# How many additional full re-runs step [02/05] Validate Web attempts when the
# first pass leaves failed steps worth retrying (pure login failures are never
# retried — different credentials, not another attempt, would fix those).
# Each attempt gets a fresh isolated browser and its own VALIDATE_WEB_TIMEOUT_S
# budget, so worst-case wall time scales with this. Set 0 to disable retries.
VALIDATE_WEB_RETRY_ATTEMPTS=1

# Set to false to run the browser in headed (visible) mode during web validation
# Useful for debugging selector issues in step [02/05] Validate Web
PLAYWRIGHT_HEADLESS=true

# By default step [03/05] Generate refuses to run when web validation confirmed
# nothing, rather than silently writing page objects against guessed locators.
# Set true to generate anyway (e.g. site unreachable, you only want scaffolding).
# ALLOW_MISSING_SELECTORS=false

# Path to Node.js binary (default: node, assumes it is on PATH)
# NODE_PATH=node

# ── Optional GitHub ───────────────────────────────────────────────────────────
# Base branch for PRs (inherits from config/.env, override here if different)
# GITHUB_DEFAULT_BRANCH=main

# Comma-separated list of GitHub reviewer handles
# GITHUB_PR_REVIEWERS=reviewer1,reviewer2
