# ─────────────────────────────────────────────────────────────────────────────
# agents/test-triaging-agent/.env.example — Agent-specific overrides
#
# Copy to agents/test-triaging-agent/.env and uncomment what you want to change.
# Values here override config/.env for this agent only.
# Shared settings (DB, GitHub, Slack) stay in config/.env.
# ─────────────────────────────────────────────────────────────────────────────

# ── Claude models ─────────────────────────────────────────────────────────────
# Model used for failure classification (03_classify.py)
CLASSIFIER_MODEL=claude-opus-4-6
# Thinking effort for the classifier: low | medium | high
CLASSIFIER_EFFORT=medium

# Model used for adversarial review (04_review.py)
REVIEWER_MODEL=claude-sonnet-4-6
# Thinking effort for the reviewer: low | medium | high
REVIEWER_EFFORT=medium

# ── Scout behaviour ───────────────────────────────────────────────────────────
# Days to look back when scanning for unanalyzed build tags
SCOUT_LOOKBACK_DAYS=7

# ── Review behaviour ──────────────────────────────────────────────────────────
# Maximum classifier/reviewer debate rounds before forcing a verdict
MAX_REVIEW_ROUNDS=2

# ── Flaky test detection ──────────────────────────────────────────────────────
# How many recent runs to examine per test
FLAKY_TESTS_LAST_RUNS=10
# Minimum number of failures within that window to flag a test as flaky
FLAKY_TESTS_MIN_FAILURES=5

# ── Handoff queue ─────────────────────────────────────────────────────────────
# Where to write the test-healing-agent handoff JSON (default: agents/test-healing-agent/queue)
# Override if test-healing-agent runs on a different machine or path
# AUTOFIX_QUEUE_DIR=
